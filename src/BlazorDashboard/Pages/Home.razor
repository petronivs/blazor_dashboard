@page "/"
@using BlazorDashboard.Services
@implements IDisposable
@inject FrankfurterClient Api
@inject TimeProvider Clock
@inject IDashboardStateStore StateStore

<PageTitle>FX Dashboard</PageTitle>

<header class="page-header">
    <h1>FX Dashboard</h1>
    <p class="muted">Daily reference rates from the <a href="https://frankfurter.dev" target="_blank" rel="noopener">Frankfurter API</a>.</p>
</header>

<aside class="cookie-notice" aria-label="Cookie notice">
    This dashboard uses a cookie to remember your selections on this device.
</aside>

@if (currencies is null)
{
    <p class="muted">@(loadError ?? "Loading currencies…")</p>
}
else
{
    <section class="controls" aria-label="Inputs">
        <label class="field">
            <span>Base currency</span>
            <select @bind="baseCode" @bind:after="OnBaseChangedAsync">
                @foreach (var c in currencies)
                {
                    <option value="@c.IsoCode">@c.IsoCode · @c.Name</option>
                }
            </select>
        </label>

        <label class="field">
            <span>Amount</span>
            <input type="number" min="0" step="any" @bind="amount" @bind:after="PersistStateAsync" />
        </label>

        <label class="field">
            <span>From</span>
            <input type="date" @bind="from" @bind:after="ReloadRatesAsync" max="@to.ToString("yyyy-MM-dd")" />
        </label>

        <label class="field">
            <span>To</span>
            <input type="date" @bind="to" @bind:after="ReloadRatesAsync" min="@from.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
        </label>

        <div class="field field-wide">
            <span>Compare against</span>
            <div class="chips">
                @foreach (var q in quotes)
                {
                    <span class="chip">
                        @q
                        <button type="button" aria-label="Remove @q" @onclick="() => RemoveQuoteAsync(q)">×</button>
                    </span>
                }
                @* @key forces a fresh <select> after each add so it resets to the placeholder. *@
                <select @key="quotes.Count" aria-label="Add currency" @onchange="AddQuoteAsync" disabled="@AtQuoteLimit">
                    <option value="">+ Add currency</option>
                    @foreach (var c in currencies.Where(c => c.IsoCode != baseCode && !quotes.Contains(c.IsoCode)))
                    {
                        <option value="@c.IsoCode">@c.IsoCode · @c.Name</option>
                    }
                </select>
                @if (AtQuoteLimit)
                {
                    <span class="muted small">Up to @MaxQuotes currencies</span>
                }
            </div>
        </div>
    </section>

    @if (rateError is not null)
    {
        <p class="error" role="alert">@rateError</p>
    }
    else if (quotes.Count == 0)
    {
        <p class="muted">Add a currency to compare against @baseCode.</p>
    }

    @* aria-busy needs a literal "true"/"false"; a bare bool would render as a presence-only attribute. *@
    <section class="cards" aria-busy="@(loading ? "true" : "false")" aria-label="Rates">
        @foreach (var s in summaries)
        {
            <article class="card">
                <header class="card-header">
                    <span class="code">@s.Quote</span>
                    <span class="muted">@NameOf(s.Quote)</span>
                </header>
                <div class="rate">@NumberFormat.Adaptive(s.Last.Value)</div>
                <div class="muted small">@s.Quote per 1 @baseCode · @s.Last.Date.ToString("MMM d, yyyy")</div>
                <div class="change">
                    @(s.Change >= 0 ? "▲" : "▼") @s.Change.ToString("+0.00%;-0.00%")
                    <span class="muted">since @s.First.Date.ToString("MMM d")</span>
                </div>
                <div class="converted">
                    @NumberFormat.Adaptive(amount) @baseCode = <strong>@NumberFormat.Adaptive(amount * s.Last.Value) @s.Quote</strong>
                </div>
            </article>
        }
    </section>

    @if (missing.Count > 0)
    {
        <p class="muted small">No rates published for @string.Join(", ", missing) in this date range.</p>
    }

    @if (rows.Count > 0)
    {
        <section class="chart-section" aria-busy="@(loading ? "true" : "false")" aria-label="Chart">
            <RateChart Rows="rows" Quotes="rowQuotes" BaseCode="@rowBase" ColorSlots="colorSlots" />
        </section>
    }
}

@code {
    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
    private static readonly string[] DefaultQuotes = ["EUR", "GBP", "JPY"];

    private IReadOnlyList<Currency>? currencies;
    private string? loadError;

    private string baseCode = "USD";
    private decimal amount = 1000m;
    private DateOnly from;
    private DateOnly to;
    // The chart palette has 8 validated colors; more series would need a 9th, generated hue.
    private const int MaxQuotes = 8;

    private readonly List<string> quotes = [.. DefaultQuotes];
    // Palette slot (1–8) per quote. A currency keeps its slot while selected, so removing
    // one never repaints the others; a new currency takes the lowest free slot.
    private readonly Dictionary<string, int> colorSlots = new() { ["EUR"] = 1, ["GBP"] = 2, ["JPY"] = 3 };

    private bool AtQuoteLimit => quotes.Count >= MaxQuotes;

    // The rows behind the chart, with the base and quotes they were fetched for.
    private IReadOnlyList<Rate> rows = [];
    private string rowBase = "";
    private IReadOnlyList<string> rowQuotes = [];

    private IReadOnlyList<RateSummary> summaries = [];
    private IReadOnlyList<string> missing = [];
    private bool loading;
    private string? rateError;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        to = Today;
        from = to.AddDays(-30);

        try
        {
            currencies = await Api.GetCurrenciesAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            loadError = $"Couldn't load currencies: {ex.Message}";
            return;
        }

        ApplySavedState(await StateStore.LoadAsync());
        await LoadRatesAsync(persistState: false);
    }

    private async Task OnBaseChangedAsync()
    {
        quotes.Remove(baseCode);
        colorSlots.Remove(baseCode);
        await LoadRatesAsync();
    }

    private async Task AddQuoteAsync(ChangeEventArgs e)
    {
        if (e.Value is string code && code.Length > 0 && !quotes.Contains(code) && !AtQuoteLimit)
        {
            quotes.Add(code);
            colorSlots[code] = NextFreeSlot();
            await LoadRatesAsync();
        }
    }

    private async Task RemoveQuoteAsync(string code)
    {
        quotes.Remove(code);
        colorSlots.Remove(code);
        await LoadRatesAsync();
    }

    private void ClearResults()
    {
        summaries = [];
        missing = [];
        rows = [];
    }

    private async Task PersistStateAsync() =>
        await StateStore.SaveAsync(new DashboardState(
            baseCode,
            amount,
            from,
            to,
            quotes.ToList(),
            colorSlots.ToDictionary(entry => entry.Key, entry => entry.Value)));

    private void ApplySavedState(DashboardState? state)
    {
        if (state is null || currencies is null)
        {
            return;
        }

        var validCodes = currencies.Select(c => c.IsoCode).ToHashSet(StringComparer.Ordinal);

        if (validCodes.Contains(state.BaseCode))
        {
            baseCode = state.BaseCode;
        }

        if (state.Amount >= 0)
        {
            amount = state.Amount;
        }

        from = state.From > Today ? Today : state.From;
        to = state.To > Today ? Today : state.To;
        if (to < from)
        {
            to = from;
        }

        quotes.Clear();
        quotes.AddRange(state.Quotes
            .Where(code => validCodes.Contains(code) && code != baseCode)
            .Distinct()
            .Take(MaxQuotes));

        colorSlots.Clear();
        foreach (var quote in quotes)
        {
            if (state.ColorSlots is not null &&
                state.ColorSlots.TryGetValue(quote, out var slot) &&
                slot >= 1 &&
                slot <= MaxQuotes &&
                !colorSlots.ContainsValue(slot))
            {
                colorSlots[quote] = slot;
                continue;
            }

            colorSlots[quote] = NextFreeSlot();
        }
    }

    private int NextFreeSlot() =>
        Enumerable.Range(1, MaxQuotes).First(slot => !colorSlots.ContainsValue(slot));

    private async Task LoadRatesAsync(bool persistState = true)
    {
        cts?.Cancel();
        cts = new CancellationTokenSource();
        var token = cts.Token;

        rateError = null;
        if (persistState)
        {
            await PersistStateAsync();
        }
        if (quotes.Count == 0)
        {
            ClearResults();
            return;
        }
        if (from > to)
        {
            rateError = "The From date must be on or before the To date.";
            ClearResults();
            return;
        }

        loading = true;
        var requestBase = baseCode;
        var requestQuotes = quotes.ToList();
        try
        {
            var fetched = await Api.GetRatesAsync(requestBase, requestQuotes, from, to, token);
            if (token.IsCancellationRequested)
            {
                return; // Superseded by a newer request; don't overwrite its results.
            }
            summaries = RateSummary.FromRates(fetched, requestQuotes);
            missing = requestQuotes.Except(summaries.Select(s => s.Quote)).ToList();
            (rows, rowBase, rowQuotes) = (fetched, requestBase, requestQuotes);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Superseded by a newer request.
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            if (token.IsCancellationRequested)
            {
                return; // A stale request failed; the newer one owns the UI.
            }
            rateError = $"Couldn't load rates: {ex.Message}";
            ClearResults();
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                loading = false;
            }
        }
    }

    private Task ReloadRatesAsync() => LoadRatesAsync();

    private string NameOf(string code) =>
        currencies?.FirstOrDefault(c => c.IsoCode == code)?.Name ?? code;

    public void Dispose() => cts?.Cancel();
}
