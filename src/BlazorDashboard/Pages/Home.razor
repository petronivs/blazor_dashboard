@page "/"

<PageTitle>World Finance Dashboard</PageTitle>

<header class="page-header">
    <h1>World Finance Dashboard</h1>
    <p class="muted">Track multiple global data sources from one place, starting with foreign exchange reference rates.</p>
</header>

<section class="dashboard-shell" aria-label="World Finance dashboard">
    <div class="dashboard-tabs" role="tablist" aria-label="World Finance data sources">
        <button
            id="tab-foreign-exchange"
            class="dashboard-tab"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-foreign-exchange">
            Foreign exchange
        </button>
    </div>

    <section
        id="panel-foreign-exchange"
        class="dashboard-panel"
        role="tabpanel"
        aria-labelledby="tab-foreign-exchange">
        <FxDashboard />
    </section>
</section>
