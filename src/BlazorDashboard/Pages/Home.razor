@page "/"

<PageTitle>World Finance Dashboard</PageTitle>

<header class="page-header">
    <h1>World Finance Dashboard</h1>
    <p class="muted">Track multiple global data sources from one place, starting with foreign exchange reference rates.</p>
</header>

<section class="dashboard-shell" aria-label="World Finance dashboard">
    <nav class="dashboard-tabs" aria-label="World Finance data sources" role="tablist">
        <button type="button"
                id="tab-foreign-exchange"
                role="tab"
                class="dashboard-tab @(activeTab == HomeTab.ForeignExchange ? "dashboard-tab-active" : null)"
                data-tab="foreign-exchange"
                aria-controls="panel-foreign-exchange"
                aria-selected="@(activeTab == HomeTab.ForeignExchange ? "true" : "false")"
                @onclick="() => activeTab = HomeTab.ForeignExchange">
            Foreign exchange
        </button>
        <button type="button"
                id="tab-inflation"
                role="tab"
                class="dashboard-tab @(activeTab == HomeTab.Inflation ? "dashboard-tab-active" : null)"
                data-tab="inflation"
                aria-controls="panel-inflation"
                aria-selected="@(activeTab == HomeTab.Inflation ? "true" : "false")"
                @onclick="() => activeTab = HomeTab.Inflation">
            Inflation
        </button>
    </nav>

    @if (activeTab == HomeTab.ForeignExchange)
    {
        <section id="panel-foreign-exchange" class="dashboard-panel" role="tabpanel" aria-labelledby="tab-foreign-exchange">
            <FxDashboard />
        </section>
    }
    else
    {
        <section id="panel-inflation" class="dashboard-panel" role="tabpanel" aria-labelledby="tab-inflation">
            <InflationDashboard />
        </section>
    }
</section>

@code {
    private enum HomeTab
    {
        ForeignExchange,
        Inflation,
    }

    private HomeTab activeTab = HomeTab.ForeignExchange;
}
